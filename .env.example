NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=authforge
DATABASE_USER=authforge
DATABASE_PASSWORD=change_me

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
MFA_CHALLENGE_EXPIRES_IN=5m
REFRESH_SESSION_DAYS=7

MFA_ENCRYPTION_KEY=replace_with_32_byte_base64_key

CORS_ORIGIN=http://localhost:3001
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
PASSWORD_RESET_MINUTES=20
